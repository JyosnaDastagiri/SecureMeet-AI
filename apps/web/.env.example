# Copy to ".env.local" in apps/web. Only NEXT_PUBLIC_* values are visible in the browser - never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Comma-separated STUN servers used by WebRTC. A TURN server is NOT included (see docs/TROUBLESHOOTING.md).
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
