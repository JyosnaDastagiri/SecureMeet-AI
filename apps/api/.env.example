# Copy this file to ".env" in apps/api and adjust. NEVER commit the real .env file.
NODE_ENV=development
PORT=4000

# Docker Compose database (host port 5433). For a local Windows PostgreSQL use port 5432 and your own password.
DATABASE_URL="postgresql://smai:smai_dev_password@localhost:5433/smai?schema=public"

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins (CORS + Socket.IO)
WEB_ORIGIN=http://localhost:3000

# Seed script: password for the demo admin/host/participant accounts (dev only)
SEED_PASSWORD=ChangeMe123
